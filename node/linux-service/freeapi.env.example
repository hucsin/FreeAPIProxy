# ============================================================
#  FreeApi (Node egress proxy) 环境变量
#  复制为 /etc/freeapi/freeapi.env 并填入真实密钥
#  注意：此文件含机密，权限必须为 600 (仅 root 可读写)
# ============================================================

# 代理服务鉴权 token —— 【必填，务必改成高强度随机串，勿用默认值】
# 管理后台「代理设置」里该 Node 代理的 Token 必须与此一致
PROXY_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# 转发模式：auto | socket | fetch（默认 auto，一般不用改）
#   auto  = 默认 Socket 直连，遇 OpenAI/Anthropic 等被 CF 保护的 host 自动转 fetch
#   socket= 强制真实 TCP/TLS 直连（Node 有完整 TLS）
#   fetch = 全部走 node 内置 fetch
# PROXY_MODE=auto

# 监听端口（默认 8788；与 unit ExecStart 里的 --port 保持一致即可，二选一即可）
# PORT=8788

# 仅在未配置 PROXY_TOKEN 时决定是否允许裸奔开放。
# 生产环境【绝不要】设成 1，否则任何能访问该端口的人都能拿它当中转。
# PROXY_ALLOW_OPEN=0
