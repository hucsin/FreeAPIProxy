<?xml version="1.0" encoding="utf-8"?>
<!--
  adaptive icon 背景层：垂直渐变（上亮下深）。

  端点色说明：
  源图标 FreeAPI.icns 在 1024 画布上是 #3496FB(顶部) → #1063E3(底部) 的渐变。
  但 adaptive icon 的图层画布是 108×108，只有中心 72×72 会被蒙版裁出可见，
  渐变被"截取"中间 2/3 后会损失对比。因此把端点色外推为 #3DA3FF → #0756DD，
  使可见区（t=1/6 → t=5/6）渲染出的颜色正好回到 #3496FB → #1063E3，与原图一致。

  angle=270 表示自上而下（Android 约定：0=左→右，90=下→上，270=上→下）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#0756DD"
        android:startColor="#3DA3FF"
        android:type="linear" />
</shape>
