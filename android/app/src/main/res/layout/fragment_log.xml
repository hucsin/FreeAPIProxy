<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!--
      日志页整页就是一张卡片，所以要用 cardFillBody 让它撑满剩余高度
      （内容区是 0dp + weight=1，直接写 match_parent 会把头部顶出屏幕）。
      折叠时 CardLayout 会把自己的 weight 也收掉，卡片缩成一条标题栏，
      不会留下一张空荡荡的大白卡。
    -->
    <com.freeapi.proxy.ui.widget.CardLayout
        style="@style/Card"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardFillBody="true"
        app:cardIcon="@drawable/ic_tab_log"
        app:cardTitle="@string/sec_log">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_copy_log" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_clear_log" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_log">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="@color/log_fg"
                android:textSize="11sp" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="只保留最近若干条，超出后自动丢弃最旧的。点「复制日志」可整段拷走；充电线相关的记录也会进这里（前缀 [充电线]）。"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </com.freeapi.proxy.ui.widget.CardLayout>
</LinearLayout>
