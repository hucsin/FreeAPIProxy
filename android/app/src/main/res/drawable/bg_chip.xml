<?xml version="1.0" encoding="utf-8"?>
<!-- 周期档位按钮底：选中态实心品牌色，未选中白底描边。状态由 View.isSelected 驱动。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_soft" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
